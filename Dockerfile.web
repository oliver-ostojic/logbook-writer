FROM node:20-slim AS base

RUN corepack enable && corepack prepare pnpm@10.20.0 --activate

WORKDIR /app

# ── deps ─────────────────────────────────────────────────────────────────────
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml turbo.json tsconfig.base.json ./

COPY apps/web/package.json           apps/web/
COPY packages/domain/package.json    packages/domain/
COPY packages/shared-types/package.json packages/shared-types/

RUN pnpm install --frozen-lockfile --filter=@logbook-writer/web... --filter=@logbook-writer/domain --filter=@logbook-writer/shared-types

# ── build ─────────────────────────────────────────────────────────────────────
COPY packages/domain/       packages/domain/
COPY packages/shared-types/ packages/shared-types/
COPY apps/web/              apps/web/

RUN pnpm turbo run build --filter=@logbook-writer/web...

# ── runtime ───────────────────────────────────────────────────────────────────
EXPOSE 3000

CMD ["sh", "-c", "cd apps/web && node_modules/.bin/next start"]
