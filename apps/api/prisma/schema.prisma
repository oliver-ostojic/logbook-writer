generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Assignment {
  id        String           @id @db.Uuid
  logbookId String           @db.Uuid
  crewId    String           @db.Char(7)
  roleId    Int
  startTime DateTime
  endTime   DateTime
  origin    AssignmentOrigin @default(ENGINE)
  locked    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  Crew      Crew             @relation(fields: [crewId], references: [id])
  Logbook   Logbook          @relation(fields: [logbookId], references: [id])
  Role      Role             @relation(fields: [roleId], references: [id])

  @@index([crewId, startTime])
}

model Company {
  id         Int          @id @default(autoincrement())
  name       String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  RoleFamily RoleFamily[]
  Store      Store[]
}

model Crew {
  id                      String                    @id @db.Char(7)
  name                    String
  storeId                 Int
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  Assignment              Assignment[]
  Store                   Store                     @relation(fields: [storeId], references: [id])
  CrewRole                CrewRole[]
  CrewRoleFairnessHistory CrewRoleFairnessHistory[]
  CrewRoleQuota           CrewRoleQuota[]
  CrewRoleRule            CrewRoleRule[]
  Shift                   Shift[]
}

model CrewRole {
  crewName       String
  roleName       String
  assignedAt     DateTime @default(now())
  crewId         String   @db.Char(7)
  roleId         Int
  specialization String?
  Crew           Crew     @relation(fields: [crewId], references: [id])
  Role           Role     @relation(fields: [roleId], references: [id])

  @@id([crewId, roleId])
}

model CrewRoleFairnessHistory {
  id              Int      @id @default(autoincrement())
  storeId         Int
  roleId          Int
  crewId          String   @db.Char(7)
  date            DateTime // The specific date this record is for
  minutesAssigned Int      @default(0) // Minutes assigned on this date
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  Crew            Crew     @relation(fields: [crewId], references: [id])
  Role            Role     @relation(fields: [roleId], references: [id])
  Store           Store    @relation(fields: [storeId], references: [id])

  @@unique([storeId, roleId, crewId, date]) // One record per crew per role per day
  @@index([storeId, roleId, date])
}

// Snapshot of role fairness metrics per day (for graphing trends)
model RoleFairnessSnapshot {
  id               Int      @id @default(autoincrement())
  storeId          Int
  roleId           Int
  date             DateTime
  
  // Fairness metrics (normalized by days worked)
  giniCoefficient  Float    @default(0) // 0 = perfect equality, 1 = max inequality
  fairnessIndex    Float    @default(0) // 100 - (gini * 100), so 100 = perfect
  fairnessGrade    String   @default("F") // A+, A, B+, B, C+, C, D, F
  
  // Distribution stats (minutes per day worked)
  minMinutesPerDay Float    @default(0)
  maxMinutesPerDay Float    @default(0)
  avgMinutesPerDay Float    @default(0)
  stdDeviation     Float    @default(0)
  
  // Counts
  eligibleCrew     Int      @default(0) // Crew who CAN do this role
  crewWithMinutes  Int      @default(0) // Crew who got minutes in lookback
  lookbackDays     Int      @default(14)
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  Role             Role     @relation(fields: [roleId], references: [id])
  Store            Store    @relation(fields: [storeId], references: [id])

  @@unique([storeId, roleId, date])
  @@index([storeId, roleId, date])
}

model CrewRoleQuota {
  id          Int      @id @default(autoincrement())
  date        DateTime
  startMin    Int
  endMin      Int
  requiredMin Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  storeId     Int
  crewId      String   @db.Char(7)
  roleId      Int
  Crew        Crew     @relation(fields: [crewId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Role        Role     @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Store       Store    @relation(fields: [storeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([storeId, date, crewId, roleId])
  @@index([storeId, date])
}

model LogPreferenceMetadata {
  id                     String   @id @db.Uuid
  logbookId              String   @unique @db.Uuid

  // Core Preference Metrics
  eligiblePreferences    Int      @default(0)  // Number of eligible preferences (rule was applicable)
  preferencesMet         Int      @default(0)  // Number of preferences met (satisfaction >= 0.5)
  percentMet             Float    @default(0)  // preferencesMet / eligiblePreferences * 100
  avgSatisfaction        Float    @default(0)  // Average satisfaction across all eligible prefs (0-100)

  // Crew Metrics
  eligibleCrew           Int      @default(0)  // Crew with ≥1 eligible preference
  avgSatisfactionPerCrew Float    @default(0)  // Average of per-crew satisfaction scores (0-100)

  // Fairness
  fairnessIndex          Float    @default(0)  // Gini-based fairness (0-100, 100=perfect equality)
  fairnessGrade          String   @default("F") // Letter grade (A+ to F)

  // Per-RoleRule Breakdown (JSON array)
  // Each entry: { roleRuleId, ruleType, eligible, met, avgSatisfaction, percentMet }
  breakdownByRoleRule    Json     @default("[]")

  // Per-Crew Breakdown (JSON array)
  // Each entry: { crewId, total, met, avgSatisfaction, satisfactionPct }
  breakdownByCrew        Json     @default("[]")

  // Per-Crew per-RuleType Breakdown (JSON array) - for crew preferences graphs
  // Each entry: { crewId, ruleType, total, met, percentMet }
  breakdownByCrewAndRuleType Json @default("[]")

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  Logbook                Logbook  @relation(fields: [logbookId], references: [id])
}

model Logbook {
  id                     String                   @id @db.Uuid
  date                   DateTime
  storeId                Int
  status                 LogbookStatus
  generatedAt            DateTime
  storedFilePath         String?
  metadata               Json?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  // Supersede tracking
  supersededById         String?                  @db.Uuid
  supersededBy           Logbook?                 @relation("SupersedesLogbook", fields: [supersededById], references: [id])
  supersedes             Logbook[]                @relation("SupersedesLogbook")

  // Audit fields
  createdByName          String?
  publishedAt            DateTime?

  Assignment             Assignment[]
  LogPreferenceMetadata  LogPreferenceMetadata?
  Store                  Store                    @relation(fields: [storeId], references: [id])
  Run                    Run[]

  @@unique([storeId, date, status])
  @@index([storeId, date])
  @@index([supersededById])
}

model Role {
  id                          Int                       @id @default(autoincrement())
  storeId                     Int
  code                        String                    @unique
  displayName                 String
  allowOutsideStoreHours      Boolean                   @default(false)
  consecutivePolicy           ConsecutivePolicy?        @default(NONE)
  windowStartOffsetMin        Int?
  windowEndOffsetMin          Int?
  minShiftLengthForRoleAccess Int?
  taskLength                  Int
  familyId                    Int
  assignmentModel             AssignmentModel
  canSplitForGaps             Boolean                   @default(false)
  codePDF                     String?                   @db.VarChar(255)
  Assignment                  Assignment[]
  CrewRole                    CrewRole[]
  CrewRoleFairnessHistory     CrewRoleFairnessHistory[]
  CrewRoleQuota               CrewRoleQuota[]
  RoleFamily                  RoleFamily                @relation(fields: [familyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Store                       Store                     @relation(fields: [storeId], references: [id])
  RoleCoverageWindow          RoleCoverageWindow[]
  RoleFairnessSnapshot        RoleFairnessSnapshot[]
  RoleFairnessTracker         RoleFairnessTracker?
  RoleRules                   RoleRule[]                @relation("RoleToRoleRules")
  TargetedByRules             RoleRule[]                @relation("TargetRoleToRoleRules")
  StoreDefaultRole            StoreDefaultRole[]
}

model RoleRule {
  id             Int             @id @default(autoincrement())
  roleId         Int
  type           RoleRuleType
  targetRoleId   Int?
  constraintType ConstraintType
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt
  description    String?
  displayName    String?
  CrewRoleRules  CrewRoleRule[]
  Role           Role            @relation("RoleToRoleRules", fields: [roleId], references: [id])
  TargetRole     Role?           @relation("TargetRoleToRoleRules", fields: [targetRoleId], references: [id])
  StoreRoleRules StoreRoleRule[]

  @@unique([roleId, type, targetRoleId])
  @@index([roleId])
}

model CrewRoleRule {
  id         Int      @id @default(autoincrement())
  crewId     String   @db.Char(7)
  roleRuleId Int
  isPriority Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  valueInt   Int?
  Crew       Crew     @relation(fields: [crewId], references: [id])
  RoleRule   RoleRule @relation(fields: [roleRuleId], references: [id], onDelete: Cascade)

  @@index([crewId])
}

model StoreRoleRule {
  id         Int      @id @default(autoincrement())
  storeId    Int
  roleRuleId Int
  isPriority Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  valueInt   Int?
  RoleRule   RoleRule @relation(fields: [roleRuleId], references: [id], onDelete: Cascade)
  Store      Store    @relation(fields: [storeId], references: [id])

  @@index([storeId])
}

model StoreDefaultRole {
  id        Int      @id @default(autoincrement())
  storeId   Int
  roleId    Int
  createdAt DateTime @default(now())
  Store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  Role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([storeId, roleId])
  @@index([storeId])
}

model RoleCoverageWindow {
  id             Int            @id @default(autoincrement())
  date           DateTime
  startMin       Int
  endMin         Int
  crewPerMinute  Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now())
  storeId        Int
  roleId         Int
  constraintRule ConstraintRule @default(EXACTLY)
  Role           Role           @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Store          Store          @relation(fields: [storeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([storeId, roleId, date, startMin, endMin])
  @@index([storeId, date])
}

model RoleFairnessTracker {
  id           Int      @id @default(autoincrement())
  storeId      Int
  roleId       Int      @unique
  lookbackDays Int      @default(14)
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  Role         Role     @relation(fields: [roleId], references: [id])
  Store        Store    @relation(fields: [storeId], references: [id])

  @@index([storeId])
}

model RoleFamily {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  displayName String
  minMinutes  Int
  maxMinutes  Int
  companyId   Int
  Role        Role[]
  Company     Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Run {
  id             String    @id @db.Uuid
  date           DateTime
  storeId        Int
  engine         String
  seed           Int
  status         RunStatus
  runtimeMs      Int
  violations     Json
  objectiveScore Int?
  mipGap         Float?
  logbookId      String?   @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  Logbook        Logbook?  @relation(fields: [logbookId], references: [id])
  Store          Store     @relation(fields: [storeId], references: [id])

  @@index([storeId, date])
}

model Shift {
  id        Int      @id @default(autoincrement())
  date      DateTime
  crewId    String   @db.Char(7)
  storeId   Int
  startMin  Int
  endMin    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Crew      Crew     @relation(fields: [crewId], references: [id])
  Store     Store    @relation(fields: [storeId], references: [id])

  @@unique([storeId, date, crewId])
  @@index([storeId, date])
}

model Store {
  id                       Int                       @id
  name                     String
  timezone                 String                    @default("EST")
  openMinutesFromMidnight  Int                       @default(480)
  closeMinutesFromMidnight Int                       @default(1260)
  companyId                Int
  Crew                     Crew[]
  CrewRoleFairnessHistory  CrewRoleFairnessHistory[]
  CrewRoleQuota            CrewRoleQuota[]
  Logbook                  Logbook[]
  Role                     Role[]
  RoleCoverageWindow       RoleCoverageWindow[]
  RoleFairnessSnapshot     RoleFairnessSnapshot[]
  RoleFairnessTracker      RoleFairnessTracker[]
  Run                      Run[]
  Shift                    Shift[]
  Company                  Company                   @relation(fields: [companyId], references: [id])
  StoreRoleRule            StoreRoleRule[]
  StoreDefaultRole         StoreDefaultRole[]

  @@index([companyId])
}

enum ConstraintRule {
  MIN
  MAX
  EXACTLY
}

enum AssignmentModel {
  HOURLY
  HOURLY_OR_WINDOW
  HOURLY_AND_SOLVER
  DAILY
  SOLVER
  WINDOW
}

enum AssignmentOrigin {
  ENGINE
  MANUAL
  ML_ADJUSTED
}

enum ConsecutivePolicy {
  REQUIRED
  PREFERRED
  NONE
}

enum LogbookStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum PreferenceType {
  FIRST_HOUR
  FAVORITE
  TIMING
  CONSECUTIVE
}

enum RoleRuleType {
  CANNOT_BE_ASSIGNED_BEFORE
  CANNOT_BE_ASSIGNED_AFTER
  MIN_CONSECUTIVE_MINUTES
  MAX_CONSECUTIVE_MINUTES
  FORBID_ROLE
  TIMING
  LIKE_ROLE_FOR_HOUR_X
  DISLIKE_ROLE_FOR_HOUR_X
  MIN_SHIFT_LENGTH_FOR_ACCESS
  ASSIGN_BEFORE_SHIFT_MIN_X
  ASSIGN_AFTER_SHIFT_MIN_X
  MAX_CREW_ON_AT_A_TIME
  ALLOW_HALF_BLOCKSIZE
  DISTRIBUTION_BETWEEN_ROLE_X
  CANNOT_ASSIGN_DURING_STORE_HOUR_X
}

enum ConstraintType {
  HARD
  SOFT
}

enum RunStatus {
  QUEUED
  RUNNING
  FEASIBLE
  OPTIMAL
  TIME_LIMIT
  INFEASIBLE
  FAILED
  CANCELED
}
