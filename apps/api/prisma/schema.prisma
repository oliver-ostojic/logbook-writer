generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Assignment {
  id        String           @id @db.Uuid
  logbookId String           @db.Uuid
  crewId    String           @db.Char(7)
  roleId    Int
  startTime DateTime
  endTime   DateTime
  origin    AssignmentOrigin @default(ENGINE)
  locked    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  Crew      Crew             @relation(fields: [crewId], references: [id])
  Logbook   Logbook          @relation(fields: [logbookId], references: [id])
  Role      Role             @relation(fields: [roleId], references: [id])

  @@index([crewId, startTime])
}

model BankedPreference {
  id               Int            @id @default(autoincrement())
  crewId           String         @db.Char(7)
  preferenceType   PreferenceType
  preferenceValue  String
  weight           Int
  originalDate     DateTime
  expiresAt        DateTime
  usedDate         DateTime?
  status           BankingStatus  @default(ACTIVE)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  storeId          Int
  rolePreferenceId Int
  Crew             Crew           @relation(fields: [crewId], references: [id])
  RolePreference   RolePreference @relation(fields: [rolePreferenceId], references: [id])
  Store            Store          @relation(fields: [storeId], references: [id])

  @@unique([crewId, rolePreferenceId, status])
  @@index([crewId, expiresAt])
  @@index([crewId, status])
}

model Company {
  id         Int          @id @default(autoincrement())
  name       String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  RoleFamily RoleFamily[]
  Store      Store[]
}

model Crew {
  id                      String                    @id @db.Char(7)
  name                    String
  storeId                 Int
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  Assignment              Assignment[]
  BankedPreference        BankedPreference[]
  Store                   Store                     @relation(fields: [storeId], references: [id])
  CrewPreference          CrewPreference[]
  CrewRole                CrewRole[]
  CrewRoleFairnessHistory CrewRoleFairnessHistory[]
  CrewRoleQuota           CrewRoleQuota[]
  PreferenceSatisfaction  PreferenceSatisfaction[]
  Shift                   Shift[]
}

model CrewPreference {
  id               Int            @id @default(autoincrement())
  crewId           String         @db.Char(7)
  rolePreferenceId Int
  crewWeight       Int            @default(1)
  intValue         Int?
  enabled          Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  Crew             Crew           @relation(fields: [crewId], references: [id])
  RolePreference   RolePreference @relation(fields: [rolePreferenceId], references: [id])

  @@index([crewId, rolePreferenceId])
}

model CrewRole {
  crewName       String
  roleName       String
  assignedAt     DateTime @default(now())
  crewId         String   @db.Char(7)
  roleId         Int
  specialization String?
  Crew           Crew     @relation(fields: [crewId], references: [id])
  Role           Role     @relation(fields: [roleId], references: [id])

  @@id([crewId, roleId])
}

model CrewRoleFairnessHistory {
  id              Int      @id @default(autoincrement())
  storeId         Int
  roleId          Int
  crewId          String   @db.Char(7)
  windowStart     DateTime
  windowEnd       DateTime
  minutesAssigned Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  Crew            Crew     @relation(fields: [crewId], references: [id])
  Role            Role     @relation(fields: [roleId], references: [id])
  Store           Store    @relation(fields: [storeId], references: [id])

  @@index([storeId, roleId, crewId, windowEnd])
}

model CrewRoleQuota {
  id          Int      @id @default(autoincrement())
  date        DateTime
  startMin    Int
  endMin      Int
  requiredMin Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  storeId     Int
  crewId      String   @db.Char(7)
  roleId      Int
  Crew        Crew     @relation(fields: [crewId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Role        Role     @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Store       Store    @relation(fields: [storeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([storeId, date, crewId, roleId])
  @@index([storeId, date])
}

model LogPreferenceMetadata {
  id                  String   @id @db.Uuid
  logbookId           String   @unique @db.Uuid
  totalPreferences    Int      @default(0)
  preferencesMet      Int      @default(0)
  averageSatisfaction Float    @default(0)
  totalWeightApplied  Float    @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  fairnessIndex       Float    @default(0)
  Logbook             Logbook  @relation(fields: [logbookId], references: [id])
}

model Logbook {
  id                     String                   @id @db.Uuid
  date                   DateTime
  storeId                Int
  status                 LogbookStatus
  generatedAt            DateTime
  storedFilePath         String?
  metadata               Json?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  Assignment             Assignment[]
  LogPreferenceMetadata  LogPreferenceMetadata?
  Store                  Store                    @relation(fields: [storeId], references: [id])
  PreferenceSatisfaction PreferenceSatisfaction[]
  Run                    Run[]

  @@unique([storeId, date, status])
}

model PreferenceSatisfaction {
  id                 Int            @id @default(autoincrement())
  crewId             String         @db.Char(7)
  date               DateTime
  logbookId          String         @db.Uuid
  adaptiveBoost      Float          @default(1.0)
  fairnessAdjustment Float          @default(0)
  createdAt          DateTime       @default(now())
  met                Boolean        @default(false)
  rolePreferenceId   Int
  satisfaction       Float          @default(0)
  weightApplied      Float          @default(0)
  Crew               Crew           @relation(fields: [crewId], references: [id])
  Logbook            Logbook        @relation(fields: [logbookId], references: [id])
  RolePreference     RolePreference @relation(fields: [rolePreferenceId], references: [id])

  @@unique([logbookId, crewId, rolePreferenceId])
  @@index([crewId, date])
  @@index([logbookId])
}

model Role {
  id                          Int                       @id @default(autoincrement())
  storeId                     Int
  code                        String                    @unique
  codePDF                     String
  displayName                 String
  allowOutsideStoreHours      Boolean                   @default(false)
  consecutivePolicy           ConsecutivePolicy?        @default(NONE)
  windowStartOffsetMin        Int?
  windowEndOffsetMin          Int?
  minShiftLengthForRoleAccess Int?
  taskLength                  Int
  canSplitForGaps             Boolean                   @default(false)
  familyId                    Int
  assignmentModel             AssignmentModel
  Assignment                  Assignment[]
  CrewRole                    CrewRole[]
  CrewRoleFairnessHistory     CrewRoleFairnessHistory[]
  CrewRoleQuota               CrewRoleQuota[]
  RoleFamily                  RoleFamily                @relation(fields: [familyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Store                       Store                     @relation(fields: [storeId], references: [id])
  RoleCoverageWindow          RoleCoverageWindow[]
  RoleFairnessTracker         RoleFairnessTracker?
  RolePreference              RolePreference[]
}

model RoleCoverageWindow {
  id                Int      @id @default(autoincrement())
  date              DateTime
  startMin          Int
  endMin            Int
  crewPerTaskLength Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())
  storeId           Int
  roleId            Int
  Role              Role     @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Store             Store    @relation(fields: [storeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([storeId, roleId, date, startMin, endMin])
  @@index([storeId, date])
}

model RoleFairnessTracker {
  id           Int      @id @default(autoincrement())
  storeId      Int
  roleId       Int      @unique
  lookbackDays Int      @default(14)
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  Role         Role     @relation(fields: [roleId], references: [id])
  Store        Store    @relation(fields: [storeId], references: [id])

  @@index([storeId])
}

model RoleFamily {
  id         Int     @id @default(autoincrement())
  name       String  @unique
  minMinutes Int
  maxMinutes Int
  companyId  Int
  Role       Role[]
  Company    Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model RolePreference {
  id                     Int                      @id @default(autoincrement())
  storeId                Int
  roleId                 Int?
  preferenceType         PreferenceType
  baseWeight             Int                      @default(1)
  allowBanking           Boolean                  @default(true)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  BankedPreference       BankedPreference[]
  CrewPreference         CrewPreference[]
  PreferenceSatisfaction PreferenceSatisfaction[]
  Role                   Role?                    @relation(fields: [roleId], references: [id])
  Store                  Store                    @relation(fields: [storeId], references: [id])

  @@unique([storeId, roleId, preferenceType])
  @@index([storeId, preferenceType])
}

model Run {
  id             String    @id @db.Uuid
  date           DateTime
  storeId        Int
  engine         String
  seed           Int
  status         RunStatus
  runtimeMs      Int
  violations     Json
  objectiveScore Int?
  mipGap         Float?
  logbookId      String?   @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  Logbook        Logbook?  @relation(fields: [logbookId], references: [id])
  Store          Store     @relation(fields: [storeId], references: [id])

  @@index([storeId, date])
}

model Shift {
  id        Int      @id @default(autoincrement())
  date      DateTime
  crewId    String   @db.Char(7)
  storeId   Int
  startMin  Int
  endMin    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Crew      Crew     @relation(fields: [crewId], references: [id])
  Store     Store    @relation(fields: [storeId], references: [id])

  @@unique([storeId, date, crewId])
  @@index([storeId, date])
}

model Store {
  id                       Int                       @id
  name                     String
  timezone                 String                    @default("EST")
  openMinutesFromMidnight  Int                       @default(480)
  closeMinutesFromMidnight Int                       @default(1260)
  companyId                Int
  BankedPreference         BankedPreference[]
  Crew                     Crew[]
  CrewRoleFairnessHistory  CrewRoleFairnessHistory[]
  CrewRoleQuota            CrewRoleQuota[]
  Logbook                  Logbook[]
  Role                     Role[]
  RoleCoverageWindow       RoleCoverageWindow[]
  RoleFairnessTracker      RoleFairnessTracker[]
  RolePreference           RolePreference[]
  Run                      Run[]
  Shift                    Shift[]
  Company                  Company                   @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

enum AssignmentModel {
  HOURLY
  HOURLY_OR_WINDOW
  DAILY
  SOLVER
  WINDOW
}

enum AssignmentOrigin {
  ENGINE
  MANUAL
}

enum BankingStatus {
  ACTIVE
  USED
  EXPIRED
  CANCELED
}

enum ConsecutivePolicy {
  REQUIRED
  PREFERRED
  NONE
}

enum LogbookStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum PreferenceType {
  FIRST_HOUR
  FAVORITE
  TIMING
  CONSECUTIVE
}

enum RunStatus {
  QUEUED
  RUNNING
  FEASIBLE
  OPTIMAL
  TIME_LIMIT
  INFEASIBLE
  FAILED
  CANCELED
}
